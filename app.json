{
  "expo": {
    "name": "Reverb",
    "slug": "Punkybeat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogotipoREVERB.png",
    "scheme": "punkybeat",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/LogotipoREVERB.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/LogotipoREVERB.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/LogotipoREVERB.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
